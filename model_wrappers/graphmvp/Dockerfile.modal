# Modal image for fine-tuning GraphMVP (model_wrappers/graphmvp/finetune.py).
# Mirrors model_wrappers/molbert/Dockerfile.modal (see that file for full
# reasoning): Modal's client library needs the primary interpreter >=3.10,
# but graphmvp_repo/requirements.txt pins torch==1.9.0+cpu/torch_geometric==
# 1.7.2/ogb==1.3.5 with no cp310+ wheels, so a separate Python 3.7 interpreter
# is copied from python:3.7-bullseye into /opt/py37. Unlike molbert, graphmvp's
# torch pin is CPU-only by design -- no GPU path here regardless of Modal.
#
# Context dir for this Dockerfile is model_wrappers/graphmvp/ itself (see
# scripts/modal_finetune_graphmvp.py's `context_dir=`).

FROM python:3.7-bullseye AS py37

FROM python:3.11-bullseye

COPY --from=py37 /usr/local /opt/py37

# numpy pinned to the last cp37-installable wheel -- same fix
# model_wrappers/molbert/Dockerfile.modal needed (torch import fails without
# a compatible numpy already present).
RUN /opt/py37/bin/python3.7 -m venv /opt/graphmvp_venv \
    && /opt/graphmvp_venv/bin/pip install --upgrade pip \
    && /opt/graphmvp_venv/bin/pip install numpy==1.21.6 joblib pyyaml scipy pandas rdkit \
    && /opt/graphmvp_venv/bin/pip install torch==1.9.0+cpu -f https://download.pytorch.org/whl/torch_stable.html

# Exact wheel URLs init.sh already uses locally (confirmed live before
# baking in here), plus torch_geometric and the rest of requirements.txt.
RUN cd /tmp \
    && wget -q https://data.pyg.org/whl/torch-1.9.0%2Bcpu/torch_cluster-1.5.9-cp37-cp37m-linux_x86_64.whl \
    && wget -q https://data.pyg.org/whl/torch-1.9.0%2Bcpu/torch_scatter-2.0.9-cp37-cp37m-linux_x86_64.whl \
    && wget -q https://data.pyg.org/whl/torch-1.9.0%2Bcpu/torch_sparse-0.6.12-cp37-cp37m-linux_x86_64.whl \
    && /opt/graphmvp_venv/bin/pip install ./torch_cluster-1.5.9-cp37-cp37m-linux_x86_64.whl \
    && /opt/graphmvp_venv/bin/pip install ./torch_scatter-2.0.9-cp37-cp37m-linux_x86_64.whl \
    && /opt/graphmvp_venv/bin/pip install ./torch_sparse-0.6.12-cp37-cp37m-linux_x86_64.whl \
    && rm -f ./*.whl \
    && /opt/graphmvp_venv/bin/pip install git+https://github.com/bp-kelley/descriptastorus@9a190343bcd3cfd35142d378d952613bcac40797 \
    && /opt/graphmvp_venv/bin/pip install "networkx" "scikit-learn" "ase" "ogb==1.3.5" \
       "torch_geometric==1.7.2" -f https://data.pyg.org/whl/torch-1.9.0+cpu.html

COPY graphmvp_repo /opt/graphmvp_repo

# Only the two "complete-feature" checkpoints are usable for the regression
# fine-tuning path (see finetune.py's module docstring); baked in from what's
# already downloaded locally rather than re-downloaded at container start.
COPY weights/regression /opt/graphmvp_weights/regression
